#!/usr/bin/env python3
"""ghostvidstream-web — minimal LAN receive settings on :8080 (decode-only).

Writes /etc/ghostvidstream/config and restarts OpenRC ghostvidstream.
No camera admin passwords are stored or accepted.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs

CONFIG_DEFAULT = "/etc/ghostvidstream/config"
STATIC_DIR = Path(__file__).resolve().parent.parent / "share" / "ghostvidstream-web"
ALLOWED_KEYS = {
    "protocol",
    "url",
    "ip",
    "bandwidth",
    "auto_search",
    "prefer_hx",
    "fullscreen",
    "stats",
    "auto_hide",
    "auto_hide_ms",
    "max_w",
    "max_h",
    "fps_cap",
    "find_ms",
    "rescan_ms",
    "noframe_ms",
    "capture_wait_ms",
}
PROTOCOLS = {"ghost_ndihx", "ndi_hx", "srt", "rtmp", "rtsp"}


def load_config(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip("\"'")
    return out


def write_config(path: Path, data: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# GhostVidStream receive config — managed by ghostvidstream-web",
        "# Decode-only appliance; no encoder/publisher settings.",
        "",
    ]
    # Preserve a stable key order for common fields, then the rest.
    order = [
        "protocol",
        "url",
        "ip",
        "auto_search",
        "prefer_hx",
        "bandwidth",
        "fullscreen",
        "stats",
        "auto_hide",
        "auto_hide_ms",
        "max_w",
        "max_h",
        "fps_cap",
        "capture_wait_ms",
        "find_ms",
        "rescan_ms",
        "noframe_ms",
    ]
    seen = set()
    for k in order:
        if k in data and data[k] != "":
            lines.append(f"{k}={data[k]}")
            seen.add(k)
    for k in sorted(data):
        if k in seen or data[k] == "":
            continue
        if k in ALLOWED_KEYS:
            lines.append(f"{k}={data[k]}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def service_running(name: str) -> bool:
    try:
        r = subprocess.run(
            ["rc-service", name, "status"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        blob = (r.stdout or "") + (r.stderr or "")
        return "started" in blob.lower() or "status: started" in blob.lower()
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False


def restart_viewer() -> tuple[bool, str]:
    try:
        r = subprocess.run(
            ["rc-service", "ghostvidstream", "restart"],
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
        msg = ((r.stdout or "") + (r.stderr or "")).strip()
        return r.returncode == 0, msg or f"exit {r.returncode}"
    except Exception as exc:  # noqa: BLE001
        return False, str(exc)


def reboot_host() -> tuple[bool, str]:
    try:
        subprocess.Popen(["reboot"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True, "reboot issued"
    except Exception as exc:  # noqa: BLE001
        return False, str(exc)


def sanitize(updates: dict[str, str]) -> dict[str, str]:
    clean: dict[str, str] = {}
    for k, v in updates.items():
        if k not in ALLOWED_KEYS:
            continue
        v = str(v).strip()
        if k == "protocol":
            p = v.lower().replace("|", "_").replace("-", "_")
            if p in ("ndi", "ndihx", "ndi_hx"):
                p = "ghost_ndihx"
            if p not in PROTOCOLS and p != "ghost_ndihx":
                raise ValueError(f"invalid protocol: {v}")
            clean[k] = p
        elif k == "bandwidth":
            b = v.lower()
            if b in ("low", "lowest"):
                clean[k] = "lowest"
            elif b in ("high", "highest", "full"):
                clean[k] = "highest"
            else:
                raise ValueError("bandwidth must be lowest|highest")
        elif k in ("auto_search", "prefer_hx", "fullscreen", "stats", "auto_hide"):
            clean[k] = "true" if v.lower() in ("1", "true", "yes", "on") else "false"
        elif k == "url":
            if v and not re.match(r"^(srt|rtmp|rtsp|http|https)://", v, re.I):
                # Allow empty clear; otherwise require a scheme for URL protocols
                if "://" not in v:
                    raise ValueError("url must include a scheme (srt://, rtmp://, rtsp://)")
            clean[k] = v
        elif k == "ip":
            if v and not re.match(r"^[0-9A-Za-z.:_-]+$", v):
                raise ValueError("invalid ip/host")
            clean[k] = v
        else:
            if v and not re.match(r"^-?[0-9]+$", v):
                raise ValueError(f"{k} must be an integer")
            clean[k] = v
    return clean


class Handler(BaseHTTPRequestHandler):
    config_path: Path = Path(CONFIG_DEFAULT)

    def log_message(self, fmt: str, *args) -> None:  # noqa: A003
        sys.stderr.write("gvs-web: " + (fmt % args) + "\n")

    def _json(self, code: int, obj: dict) -> None:
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _html(self, code: int, text: str) -> None:
        body = text.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_json(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b"{}"
        if not raw:
            return {}
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if ctype == "application/x-www-form-urlencoded":
            qs = parse_qs(raw.decode("utf-8", errors="replace"))
            return {k: (v[0] if v else "") for k, v in qs.items()}
        return json.loads(raw.decode("utf-8"))

    def do_GET(self) -> None:  # noqa: N802
        if self.path in ("/", "/index.html"):
            index = STATIC_DIR / "index.html"
            if index.is_file():
                self._html(200, index.read_text(encoding="utf-8"))
            else:
                self._html(200, "<html><body><h1>GhostVidStream</h1><p>Missing index.html</p></body></html>")
            return
        if self.path.startswith("/api/status"):
            cfg = load_config(self.config_path)
            self._json(
                200,
                {
                    "ok": True,
                    "config": cfg,
                    "viewer_running": service_running("ghostvidstream"),
                    "web_running": True,
                    "mode": "decode-only",
                },
            )
            return
        self._json(404, {"ok": False, "error": "not found"})

    def do_POST(self) -> None:  # noqa: N802
        if self.path.startswith("/api/settings"):
            try:
                updates = sanitize(self._read_json())
            except (ValueError, json.JSONDecodeError) as exc:
                self._json(400, {"ok": False, "error": str(exc)})
                return
            cfg = load_config(self.config_path)
            cfg.update(updates)
            # Clear url when switching to NDI without a url field in payload
            write_config(self.config_path, cfg)
            ok, msg = restart_viewer()
            self._json(200 if ok else 500, {"ok": ok, "message": msg, "config": cfg})
            return
        if self.path.startswith("/api/restart"):
            ok, msg = restart_viewer()
            self._json(200 if ok else 500, {"ok": ok, "message": msg})
            return
        if self.path.startswith("/api/reboot"):
            ok, msg = reboot_host()
            self._json(200 if ok else 500, {"ok": ok, "message": msg})
            return
        self._json(404, {"ok": False, "error": "not found"})


def main() -> int:
    ap = argparse.ArgumentParser(description="GhostVidStream LAN settings UI")
    ap.add_argument("--bind", default=os.environ.get("GVS_WEB_BIND", "0.0.0.0"))
    ap.add_argument("--port", type=int, default=int(os.environ.get("GVS_WEB_PORT", "8080")))
    ap.add_argument("--config", default=os.environ.get("GVS_CONFIG", CONFIG_DEFAULT))
    args = ap.parse_args()
    Handler.config_path = Path(args.config)
    # Prefer overlay path used on appliance
    global STATIC_DIR
    for cand in (
        Path("/usr/local/share/ghostvidstream-web"),
        Path(__file__).resolve().parent.parent / "share" / "ghostvidstream-web",
        Path(__file__).resolve().parent / "share" / "ghostvidstream-web",
    ):
        if (cand / "index.html").is_file():
            STATIC_DIR = cand
            break
    httpd = ThreadingHTTPServer((args.bind, args.port), Handler)
    print(f"ghostvidstream-web listening on http://{args.bind}:{args.port}/", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
